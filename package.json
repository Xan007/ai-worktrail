{
  "name": "ai-worktrail",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema de auditoría y análisis de uso de IA en entregas académicas. Evalúa el nivel de uso crítico de herramientas como Gemini, ChatGPT y Claude por parte de estudiantes.",
  "author": "Sander Sierra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xan007/ai-worktrail.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "@clerk/themes": "^2.4.57",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "reactDoctor": {
    "ignore": [
      "supabase/**",
      "dist/**"
    ],
    "rules": {
      "no-giant-component": "off"
    }
  }
}
